# Records docs/assets/relay-demo.sh, which runs the shipped Relay tool in a
# sandbox. Re-record from the repo root with: vhs docs/assets/relay-demo.tape
Output docs/assets/relay-demo.gif

Set FontSize 16
Set Width 900
Set Height 540
Set Padding 14
Set TypingSpeed 35ms

Type "docs/assets/relay-demo.sh"
Enter
Sleep 18s
